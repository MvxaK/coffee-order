    <bpmn:serviceTask id="Activity_0bbd9u2" name="Создать заказ">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8082/api/order-processes</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">${createOrderRequest}</camunda:inputParameter>
            <camunda:inputParameter name="headers">${coffeeServiceAuth.headers()}</camunda:inputParameter>
            <camunda:outputParameter name="orderId">
              <camunda:script scriptFormat="javascript">JSON.parse(response).id;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="orderStatus">
              <camunda:script scriptFormat="javascript">JSON.parse(response).orderStatus;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="paymentStatus">
              <camunda:script scriptFormat="javascript">JSON.parse(response).paymentStatus;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="userId">
              <camunda:script scriptFormat="javascript">JSON.parse(response).userId;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.removeVariable("createOrderRequest");</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0050clh</bpmn:incoming>
      <bpmn:outgoing>Flow_0us2dr0</bpmn:outgoing>
